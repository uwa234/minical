COMPOSE_PROJECT_NAME=minical

# database connection

DATABASE_HOST='db'
DATABASE_USER='root'
DATABASE_PASS='MiniCalPwd'
DATABASE_NAME='minical'

# Set it to 'production' or 'development'
ENVIRONMENT='development'

# PATH to minical/public folder (for example, http://localhost/minical/public)
# NOTE: change `localhost` to your actual IP address
PROJECT_URL='http://localhost:8080/public'

# PATH to minical/api folder (for example, http://localhost/minical/api)
# NOTE: change `localhost` to your actual IP address
# web is a container name for minical web container inside docker
API_URL='http://web/api'


# AWS info

AWS_ACCESS_KEY='ENTER YOUR AWS ACCESS KEY HERE'
AWS_SECRET_KEY='ENTER YOUR AWS SECRET KEY HERE'
AWS_S3_BUCKET='ENTER YOUR AWS S3 BUCKET NAME'


# smtp email info

SMTP_USER='ENTER YOUR SMTP USER HERE'
SMTP_PASS='ENTER YOUR SMTP PASS HERE'


# Capthcha info

RECAPTCHA_SITE_KEY='ENTER YOUR RECAPTCHA SITE KEY HERE'
RECAPTCHA_SECRET_KEY='ENTER YOUR RECAPTCHA SECRET KEY HERE'

# Security (recommended for production)

CRON_AUTH_SECRET=''
MIGRATION_SECRET=''
CURL_SSL_VERIFY='1'

# Session signing / encryption key (required in production). Generate with: openssl rand -hex 32
# Changing it logs everyone out once.
ENCRYPTION_KEY=''

# Optional: comma-separated API keys allowed to act for any company (server-to-server only).
API_PLATFORM_KEYS=''

# Optional: extra origins allowed to POST to the app, e.g. https://www.veurion.com
CSRF_TRUSTED_ORIGINS=''

# Optional: ?dev_mode=<DEVMODE_PASS> enables the profiler. Ignored unless 16+ characters.
DEVMODE_PASS=''

# Defaults for newly created hotels (Nigerian presets apply when the currency is NGN or country is Nigeria)
DEFAULT_COMPANY_TIMEZONE='Africa/Lagos'
DEFAULT_COMPANY_CURRENCY='NGN'
DEFAULT_COMPANY_COUNTRY='Nigeria'
