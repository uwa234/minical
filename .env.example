# database connection

DATABASE_HOST = 'ENTER YOUR DATABSE HOST NAME'
DATABASE_USER = 'ENTER YOUR DATABSE USER NAME'
DATABASE_PASS = 'ENTER YOUR DATABSE PASSWORD'
DATABASE_NAME = 'ENTER YOUR DATABSE NAME'

# Set it to 'production' or 'development'
ENVIRONMENT = 'development'

# PATH to Veurion public folder (for example, http://localhost/minical/public)
PROJECT_URL = 'http://localhost/minical/public'

# PATH to Veurion api folder (for example, http://localhost/minical/api)
API_URL = 'http://localhost/minical/api'


# AWS info

AWS_ACCESS_KEY = 'ENTER YOUR AWS ACCESS KEY HERE'
AWS_SECRET_KEY = 'ENTER YOUR AWS SECRET KEY HERE'
AWS_S3_BUCKET = 'ENTER YOUR AWS S3 BUCKET NAME'


# smtp email info (required for password reset, booking emails, etc.)

SMTP_USER = 'ENTER YOUR SMTP USER HERE'
SMTP_PASS = 'ENTER YOUR SMTP PASS HERE'
# SMTP_HOST: e.g. smtp.sendgrid.com, smtp.gmail.com, smtp.mail.us-east-1.awsapps.com (AWS WorkMail)
SMTP_HOST = 'ENTER YOUR SMTP HOST HERE'
# SMTP_PORT: 587 (TLS) or 465 (SSL for WorkMail)
SMTP_PORT = '587'
# SMTP_CRYPTO: '' for SendGrid on 587 with STARTTLS, 'ssl' for port 465, 'tls' for port 587
SMTP_CRYPTO = ''
# Optional overrides for auth/transactional mail (defaults to SMTP_USER as From when using SMTP)
# MAIL_FROM =
# MAIL_REPLY_TO = support@veurion.com

# Capthcha info

RECAPTCHA_SITE_KEY = 'ENTER YOUR RECAPTCHA SITE KEY HERE'
RECAPTCHA_SECRET_KEY = 'ENTER YOUR RECAPTCHA SECRET KEY HERE'

# Security (recommended for production)

# Shared secret for HTTP cron endpoints (header: X-Cron-Auth, or ?auth=, or URL segment)
CRON_AUTH_SECRET = ''

# Automated night audit alerts (optional; uses SMTP_* above). Set to 0 to disable emails.
# NIGHT_AUDIT_SEND_ALERTS = '1'
# NIGHT_AUDIT_ALERT_EMAIL = 'ops@your-hotel.com'

# Optional secret required for web installer migrations (?migration_secret=)
MIGRATION_SECRET = ''

# TLS verification for outbound cURL (set to 0 only for local dev with self-signed certs)
CURL_SSL_VERIFY = '1'

# Paystack: configure public and secret keys under Settings → Accounting → Payment Gateway (select Paystack).
# Booking engine step 3 will offer "Pay now with Paystack" and "Pay at hotel" when Paystack is selected.
# Platform SaaS billing (account_settings/subscription checkout)
# PAYSTACK_SAAS_SECRET_KEY = 'sk_live_xxx'

# SaaS / hosted multi-tenant mode (single app, many properties). Set to 1 on your production host.
# When enabled, / serves the marketing homepage; hotel login is at /auth/login; platform admin at /admin.
# IS_HOSTED_PROD_SERVICE=1

# Platform super admin email is defined in application/config/constants.php (SUPER_ADMIN).
# Platform admin login: /admin — dashboard, tenants, revenue, trial/pricing settings.

# WhatsApp Booking Management extension (Meta webhook signature verification)
WHATSAPP_APP_SECRET =

# Cron: expire ended trials (schedule daily), e.g. GET /cron/expire_platform_trials?auth=YOUR_CRON_AUTH_SECRET

# Integration tests (optional; uses a separate database — never point at production)
TEST_DATABASE_HOST = '127.0.0.1'
TEST_DATABASE_USER = 'root'
TEST_DATABASE_PASS = 'password'
TEST_DATABASE_NAME = 'minical_test'
